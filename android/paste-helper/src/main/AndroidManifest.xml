<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="DroidDock Paste Helper" android:allowBackup="false">
        <provider
            android:name=".PasteProvider"
            android:authorities="ai.hooware.droiddock.paste.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".PasteReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.hooware.droiddock.paste.SET_CLIP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
